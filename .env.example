# Windfall environment variables
#
# Every variable the app reads is listed here with a one-line explanation
# and a blank value. To run locally, copy this file to .env.local and fill
# in the values. Never commit real values; .env.local is gitignored.
#
# NODE_ENV is set automatically by Next.js, so it isn't listed here.

# --- Supabase (Phase 1) ---
# Local development and preview deployments use the windfall-dev project.
# The keys are in the dashboard under Settings > API Keys; the project URL
# is shown there and in the Connect dialog.

# The project's API endpoint, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The project's publishable key, which starts with sb_publishable_. It is
# public by design and ships to the browser. Row Level Security, added in
# Phase 2, is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
